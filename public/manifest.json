{
  "manifest_version": 3,
  "name": "Back to Work",
  "version": "1.0",
  "description": "Get back to work, maggot!",
  "action": {
    "default_popup": "../src/popup/index.html"
  },
  "side_panel": {
    "default_path": "../src/sidePanel/index.html"
  },
  "options_page" : "../src/options/options.html",
  "background": {
    "service_worker": "./service-worker/service-worker.js"
    },
  "content_scripts": [
    {
      "js": [
        "./content-script/content-script.js"
      ],
      "matches": [
        "http://*.example.com//"
      ]
    }
  ],
  "permissions": ["storage", "scripting", "activeTab", "sidePanel"]
}
