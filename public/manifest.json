{
  "manifest_version": 3,
  "name": "Back to Work",
  "version": "1.0",
  "description": "Get back to work, maggot!",
  "action": {
    "default_popup": "../src/popup/index.html"
  },
  "side_panel": {
    "default_path": "../src/sidePanel/index.html"
  },
  "options_page" : "../src/options/index.html",
  "background": {
    "service_worker": "./background-script/background-script.js"
    },
  "content_scripts": [{
      "matches": ["<all_urls>"],
      "js": [
        "./content-script/content-script.js"
      ],
      "type": "module"
    }],
  "web_accessible_resources": [{
    "resources": ["content-script/main.js", "main/main.css", "client/client.js"],
    "matches": ["<all_urls>"]
  }],
  "permissions": ["storage", "scripting", "activeTab", "sidePanel"]
}
